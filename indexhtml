    <style>
        :root {
            --rbx-red: #e02438;
            --rbx-blue: #00a2ff;
            --dark-bg: #0b0e14;
            --card-bg: #131823;
            --text-color: #ffffff;
            --text-muted: #8b9bb4;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-color);
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Навигация */
        .navbar {
            background-color: rgba(11, 14, 20, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--text-color) !important;
        }

        .nav-link {
            color: var(--text-muted) !important;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--rbx-red) !important;
        }

        /* Hero секция */
        .hero-section {
            padding: 160px 0 100px;
            background: radial-gradient(circle at 80% 20%, rgba(224, 36, 56, 0.15) 0%, transparent 50%),
                        radial-gradient(circle at 20% 80%, rgba(0, 162, 255, 0.1) 0%, transparent 50%);
            position: relative;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.1;
        }

        .text-gradient {
            background: linear-gradient(135deg, #ffffff 20%, var(--rbx-red) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Карточки с эффектом стекла */
        .glass-card {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .glass-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            border-color: rgba(224, 36, 56, 0.4);
        }

        /* Видео / Плейсхолдеры */
        .game-thumb-wrapper {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            aspect-ratio: 16/9;
        }

        .game-thumb-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .game-thumb-wrapper:hover img {
            transform: scale(1.06);
        }

        .play-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            width: 60px;
            height: 60px;
            background: var(--rbx-red);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.6rem;
            opacity: 0.9;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .game-thumb-wrapper:hover .play-overlay {
            transform: translate(-50%, -50%) scale(1.1);
            opacity: 1;
        }

        /* Кнопки */
        .btn-roblox {
            background-color: var(--rbx-red);
            color: white;
            font-weight: 700;
            border-radius: 50px;
            padding: 12px 30px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(224, 36, 56, 0.4);
        }

        .btn-roblox:hover {
            background-color: #c71b2d;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(224, 36, 56, 0.6);
        }

        .btn-outline-custom {
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: var(--text-color);
            font-weight: 600;
            border-radius: 50px;
            padding: 12px 30px;
            background: transparent;
            transition: all 0.3s ease;
        }

        .btn-outline-custom:hover {
            border-color: var(--text-color);
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-color);
        }

        /* Статистика */
        .stat-item {
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }
        .stat-item:last-child {
            border-right: none;
        }

        /* Бейджи */
        .badge-roblox {
            background: rgba(0, 162, 255, 0.1);
            color: var(--rbx-blue);
            border: 1px solid rgba(0, 162, 255, 0.2);
        }

        footer {
            background-color: #07090e;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        @media (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
            }
            .stat-item {
                border-right: none;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                padding-bottom: 20px;
                margin-bottom: 20px;
            }
            .stat-item:last-child {
                border-bottom: none;
                padding-bottom: 0;
                margin-bottom: 0;
            }
        }
    </style>
